# ==============================================================================
# Satyarthi Solar Solution - Environment Variables Template
# Copy to .env for local development or set in cPanel Environment Manager
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ==============================================================================

# Application Debug Mode (false for production, true for development)
# WARNING: Keep false in production to prevent leaking sensitive stack traces!
APP_DEBUG=false

# Notification Email for New Leads
NOTIFICATION_EMAIL=satyarthisolarsolution@gmail.com

# Database Connection (Optional - leave empty to use lightweight JSON storage)
DB_HOST=localhost
DB_USER=cpaneluser_solar
DB_PASS=YourSecurePassword123!
DB_NAME=cpaneluser_solardb

# Admin Authentication
# Salt used for SHA-256 fallback (Change this to a random 32-character string)
ADMIN_SALT=solar_satyarthi_secure_salt_2026

# Admin Password Hash (Defaults to hashed version of satyarthi2026)
# To change: generate a new bcrypt or salted SHA-256 hash
ADMIN_PASSWORD_HASH=39a5cfeed284dfba473ea3b101f398312f9d8b41755f2c7b1df7ec94d8dc3efc
